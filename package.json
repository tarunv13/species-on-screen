{
  "name": "eco-cinema-observatory",
  "private": true,
  "version": "0.1.0",
  "description": "Eco-Cinema Observatory (species-on-screen): a doctrine-governed cinematic + research ecological observatory with Darwin Core interaction archives.",
  "license": "Apache-2.0",
  "author": "tarunv13",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarunv13/species-on-screen.git"
  },
  "homepage": "https://tarunv13.github.io/species-on-screen/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check-narratives && npm run check-manifest && npm run check-bindings && npm run check-dwca-xml && npm run build:evidence",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-tmdb-data.js",
    "ingest": "node scripts/ingest/build-dwca.mjs",
    "ingest:news": "node scripts/ingest/build-news.mjs",
    "new-narrative": "node scripts/new-narrative.js",
    "check-narratives": "node scripts/check-narratives.js",
    "check-manifest": "node scripts/check-manifest.js",
    "check-bindings": "node scripts/check-bindings.js",
    "check-dwca-xml": "node scripts/check-dwca-xml.js",
    "build:evidence": "node scripts/build-evidence.mjs",
    "curator-worksheet": "node scripts/curator-worksheet.mjs",
    "conformance:build": "node test/conformance/build.mjs",
    "test:conformance": "node scripts/check-bindings.test.mjs",
    "test:surface-links": "node scripts/surface-links.test.mjs",
    "test:biome-backdrop": "node scripts/biome-backdrop.test.mjs",
    "test:dwca-xml": "node scripts/check-dwca-xml.test.mjs",
    "test:evidence-reach": "node scripts/evidence-reach.test.mjs",
    "verify": "npm run check-narratives && npm run check-manifest && npm run check-bindings && npm run check-dwca-xml && npm run test:conformance && npm run test:surface-links && npm run test:biome-backdrop && npm run test:dwca-xml && npm run test:evidence-reach"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "vite": "^8.0.14"
  }
}

*.local

# Local Claude Code config
.claude/

# Derived evidential-depth surface (regenerated every build by scripts/build-evidence.mjs)
public/evidence/
Claude design print.pdf
.gstack/

# Third-party skill payload (V1.4 ruling). The .agents/ tree is the
# institutional-memory record — decisions, sessions, thoughts. A vendored
# 153-file dependency does not belong in it; a future session reading that
# tree must find only our own record. The lockfile IS committed: it is a
# provenance receipt naming which version of a third-party tool touched the
# repo. Ignore the payload, keep the receipt.
.agents/skills/

# --- Secrets. Never commit a credential. ---------------------------------
# The research pipeline names environment variables in
# research/config/pipeline.config.json and reads their values from here.
# .env.example is the committed template and carries no real values.
.env
.env.*
!.env.example

# Research pipeline working state: raw API payloads, run manifests, receipt
# logs, the quota ledger and the artefact-id ledger. Reproducible from the
# manifests; large; and the raw payloads are third-party content.
research/var/

# Python bytecode
__pycache__/
*.py[cod]

# Third-party articles and media kept locally for reading. Copyrighted; this
# repository is not a redistribution channel.
Media and research articles/

# A third-party document dropped into the working tree, not authored here and
# not part of this project. Kept local, never committed.
National_security_assessment_*.md

# Third-party journal article, kept locally for reading. Copyrighted; this
# repository is not a redistribution channel.
Conservation Biology - 2026 - Giebink*.pdf
*.pdf

# --- Not for the public repository -----------------------------------------
# Everything below stays on the researcher's disk and in the private mirror.
# Nothing here is deleted; it is simply never committed to the public tree.

# The book manuscript. Version it in a PRIVATE repository, not this one —
# a public repo cannot hide a directory from readers.
private-book/

# Unpublished Paper 1 instrument: coding manuals, methodology audit, the IRR
# subsample and the training-set answer key. A public answer key destroys
# inter-coder reliability, and the method is unpublished. Opens up once the
# papers land.
paper1-*
papers_with_link_*.csv
.agents/tasks/task-research-matrix/
.agents/tasks/task-pilot-execution/

# Live corpus working data written by the research pipeline (candidate rows,
# coder notes, weekly snapshots). Human-subject-adjacent and not reproducible
# output — it is the corpus itself.
.agents/tasks/task-pilot-execution/data/

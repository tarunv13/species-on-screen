# Template for .env. Copy to .env and fill in real values:
#     cp .env.example .env
# .env is gitignored; this file is committed and must never carry a real key.
#
# Names here must match the *_env keys in research/config/pipeline.config.json.

# Google / YouTube Data API v3 — sources.youtube.api_key_env
# Create at https://console.cloud.google.com/apis/credentials, enable
# "YouTube Data API v3", and restrict the key to that single API.
YOUTUBE_API_KEY=

# TMDB — sources.tmdb.api_key_env
TMDB_API_KEY=

# OMDb — sources.omdb.api_key_env (disabled by default)
OMDB_API_KEY=

# IGDB / Twitch OAuth — sources.igdb (disabled by default)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# IUCN Red List API v4 — sources.iucn_redlist.api_key_env
IUCN_REDLIST_TOKEN=

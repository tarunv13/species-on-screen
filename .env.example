# Template for .env. Copy to .env and fill in real values:
#     cp .env.example .env
# .env is gitignored; this file is committed and must never carry a real key.
#
# Names here must match the *_env keys in research/config/pipeline.config.json.

# Google / YouTube Data API v3 — sources.youtube.api_key_env
# Create at https://console.cloud.google.com/apis/credentials, enable
# "YouTube Data API v3", and restrict the key to that single API.
YOUTUBE_API_KEY=

# TMDB — sources.tmdb.api_key_env
TMDB_API_KEY=

# OMDb — sources.omdb.api_key_env (disabled by default)
OMDB_API_KEY=

# IGDB / Twitch OAuth — sources.igdb (disabled by default)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# IUCN Red List API v4 — sources.iucn_redlist.api_key_env
IUCN_REDLIST_TOKEN=

# --- Where the corpus lives -------------------------------------------------
# This repository is public and holds only the code. The Paper 1 instrument and
# the pilot corpus live in the PRIVATE repository tarunv13/species-on-screen-research,
# because the method must not be publishable by anyone else before it is
# published here.
#
# The pipeline's configured workspace_root assumes that repository is checked
# out beside this one:
#
#     GitHub/
#       species-on-screen/           <- this repository
#       species-on-screen-research/  <- the private one
#
# If yours lives elsewhere, point SOS_WORKSPACE_ROOT at that checkout's
# task-pilot-execution/ directory. The environment variable wins over the
# configured path.
#
# Leave it unset and the read-only commands (doctor, plan,
# registry --print-postgres-ddl) still work; anything that writes a corpus row
# refuses rather than inventing a phantom workspace.
SOS_WORKSPACE_ROOT=
